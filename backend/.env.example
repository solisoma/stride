STRIDE_DATABASE_URL=sqlite:///learnforward.db
STRIDE_STORAGE=uploads
LLM_API_KEY=
LLM_BASE_URL=
LEARNING_MODEL=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=
MAX_UPLOAD_BYTES=20971520
MAX_MEDIA_SECONDS=1800

# Enable for HTTPS deployments; keep false for local HTTP.
SESSION_SECURE=false

# Semantic pipeline models; blank values fall back to LEARNING_MODEL.
TREE_BUILDER_MODEL=
RETRIEVAL_MODEL=
VISION_MODEL=
TREE_FANOUT=5
OLLAMA_ENABLED=false

# Structured console and rotating file logs (no request bodies or credentials)
LOG_LEVEL=INFO
# LOG_DIR defaults to backend/logs
# LOG_DIR=C:/path/to/logs

# LLM tracing: prompts and responses are sent to your private LangSmith project.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=stride
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Shared model pacing across pipeline, coaching, vision, and transcription
LLM_MAX_CONCURRENCY=1
LLM_MIN_INTERVAL_SECONDS=1
LLM_RATE_LIMIT_RETRIES=2

# Bounds network waits during graceful shutdown (seconds per SDK timeout)
LLM_TIMEOUT_SECONDS=30

# Local extractive summaries; set llm for comparison
SUMMARY_BACKEND=textrank

# RabbitMQ; Compose overrides this with the internal broker address.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
INGESTION_MAX_ATTEMPTS=3

# Local transcription: uv sync --extra local-whisper
TRANSCRIPTION_PROVIDER=api
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# Empty means automatic language detection, e.g. en or fr to specify.
WHISPER_LANGUAGE=
